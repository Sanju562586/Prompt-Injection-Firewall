# ============================================================
# Prompt Injection Firewall - Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# --- LLM Provider ---
# Options: "local" (default, no API needed), "openai", "ollama", "custom"
LLM_PROVIDER=local

# --- OpenAI (if LLM_PROVIDER=openai) ---
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1  # Optional: override for proxies / Azure
# LLM_MODEL=gpt-4o                           # Model to use

# --- Ollama (if LLM_PROVIDER=ollama) ---
# LLM_PROVIDER=ollama
# OPENAI_BASE_URL=http://localhost:11434      # Ollama local endpoint
# LLM_MODEL=llama3                           # Ollama model name

# --- Custom OpenAI-compatible endpoint ---
# LLM_PROVIDER=custom
# OPENAI_API_KEY=your-custom-key
# OPENAI_BASE_URL=https://your-endpoint.com/v1
# LLM_MODEL=your-model-name
